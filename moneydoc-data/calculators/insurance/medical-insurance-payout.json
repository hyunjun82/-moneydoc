  "formula": [
    {
      "step": 1,
      "name": "공제 후 의료비",
      "expr": "max(0, 의료비 - 면책금)"
    },
    {
      "step": 2,
      "name": "보험금",
      "expr": "round(공제후 × (1 - 자기부담률))"
    },
    {
      "step": 3,
      "name": "최종 본인부담",
      "expr": "의료비 - 보험금"
    }
  ],
