{
  "id": "auto-tax",
  "category": "insurance",
  "subCategory": "vehicle",
  "title": "자동차세 계산기 (정기)",
  "subtitle": "배기량과 차량 연식으로 1년 자동차세와 지방교육세를 계산해요. 3년차부터 해마다 5%씩 경감돼 최대 50%까지 줄어요.",
  "slug": "auto-tax",
  "searchAliases": [
    "자동차세 계산기",
    "자동차세",
    "자동차세 경감",
    "차량세"
  ],
  "year": 2026,
  "lastUpdated": "2026-05-09",
  "lastVerified": "2026-09-02",
  "source": {
    "primary": {
      "agency": "행정안전부",
      "document": "지방세법 §127 (자동차세)",
      "year": 2026,
      "laws": [
        "지방세법 제127조 (자동차세 세율)",
        "지방세법 제130조 (지방교육세)",
        "지방세법 시행령 §123 (연식별 경감)"
      ]
    }
  },
  "constants": {
    "EDU_TAX_RATE": 0.3,
    "RATE_UNDER_1000": 80,
    "RATE_1000_1600": 140,
    "RATE_OVER_1600": 200
  },
  "formula": [
    {
      "step": 1,
      "name": "기본 자동차세",
      "expr": "배기량(cc) × cc당 세율"
    },
    {
      "step": 2,
      "name": "연식 경감",
      "expr": "3~5년 5%/년 (최대 25%) → 6~12년 누적 → 12년+ 50% 고정"
    },
    {
      "step": 3,
      "name": "경감 후 자동차세",
      "expr": "기본세 × (1 - 경감률)"
    },
    {
      "step": 4,
      "name": "지방교육세",
      "expr": "경감 후 자동차세 × 30%"
    },
    {
      "step": 5,
      "name": "총 납부",
      "expr": "자동차세 + 지방교육세"
    }
  ],
  "inputs": [
    {
      "id": "engineCC",
      "label": "배기량 (cc)",
      "type": "number",
      "min": 0,
      "max": 6000,
      "default": 1999
    },
    {
      "id": "vehicleAge",
      "label": "차량 연식 (등록 후 년)",
      "type": "number",
      "min": 0,
      "max": 20,
      "default": 0,
      "hint": "등록 후 만 N년 (신차=0). 지방세법 사용연수 = N + 1 (등록한 해도 1년차로 카운트)"
    },
    {
      "id": "isCommercial",
      "label": "영업용 여부",
      "type": "boolean",
      "default": false
    }
  ],
