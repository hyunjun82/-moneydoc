  "formula": [
    {
      "step": 1,
      "name": "기본 자동차세",
      "expr": "배기량(cc) × cc당 세율"
    },
    {
      "step": 2,
      "name": "연식 경감",
      "expr": "3~5년 5%/년 (최대 25%) → 6~12년 누적 → 12년+ 50% 고정"
    },
    {
      "step": 3,
      "name": "경감 후 자동차세",
      "expr": "기본세 × (1 - 경감률)"
    },
    {
      "step": 4,
      "name": "지방교육세",
      "expr": "경감 후 자동차세 × 30%"
    },
    {
      "step": 5,
      "name": "총 납부",
      "expr": "자동차세 + 지방교육세"
    }
  ],
