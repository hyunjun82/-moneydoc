  "formula": [
    {
      "step": 1,
      "name": "LTV 한도",
      "expr": "housePrice × LTV비율"
    },
    {
      "step": 2,
      "name": "절대 cap",
      "expr": "수도권: 6억 (25억 초과 시 8억)"
    },
    {
      "step": 3,
      "name": "DSR 한도",
      "expr": "월가용액 × ((1+r)^n − 1) / (r × (1+r)^n)"
    },
    {
      "step": 4,
      "name": "최종 한도",
      "expr": "min(LTV한도, DSR한도)"
    }
  ],
