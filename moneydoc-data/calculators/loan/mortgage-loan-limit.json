    "주담대 계산기",
    "주택담보대출 한도",
    "주담대 한도"
  ],
  "year": 2026,
  "lastUpdated": "2026-09-01",
  "lastVerified": "2026-09-01",
  "source": {
    "primary": {
      "agency": "금융위원회·금융감독원",
      "document": "주택담보대출 LTV+DSR 통합 + 주택시장 안정화 대출수요 관리 방안 (2025.10.16 시행)",
      "year": 2026,
      "laws": [
        "은행업감독규정 §29의2",
        "금융위원회 주택시장 안정화를 위한 대출수요 관리 방안 (2025.10.16 시행, 수도권·규제지역 주담대 한도 15억↓ 6억/15~25억 4억/25억↑ 2억)"
      ]
    }
  },
  "constants": {
    "CAP_15EOK_UNDER": 600000000,
    "CAP_15_TO_25EOK": 400000000,
    "CAP_25EOK_OVER": 200000000,
    "CAP_THRESHOLD_15EOK": 1500000000,
    "CAP_THRESHOLD_25EOK": 2500000000
  },
  "formula": [
    {
      "step": 1,
      "name": "LTV 한도",
      "expr": "주택가격 × LTV 한도비율"
    },
    {
      "step": 2,
      "name": "절대 cap",
      "expr": "수도권·규제지역: 시가 15억 이하 6억 / 15~25억 4억 / 25억 초과 2억 (금융위 2025.10.16)"
    },
    {
      "step": 3,
      "name": "DSR 한도",
      "expr": "월가용액 × ((1+월이자율)^회차 − 1) / (월이자율 × (1+월이자율)^회차)"
    },
    {
      "step": 4,
      "name": "최종 한도",
      "expr": "min(LTV한도, DSR한도)"
    }
  ],
