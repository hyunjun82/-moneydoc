  "title": "DSR 계산기",
  "subtitle": "연소득과 기존 대출로 DSR 기준 최대 대출 한도를 계산해요. 2025년 7월부터 적용된 스트레스 DSR 3단계 가산금리 1.5%p도 반영해요.",
  "slug": "dsr-limit",
  "searchAliases": [
    "DSR 계산기",
    "총부채원리금상환비율",
    "스트레스 DSR",
    "DSR 한도"
  ],
  "year": 2026,
  "lastUpdated": "2026-05-09",
  "lastVerified": "2026-05-07",
  "source": {
    "primary": {
      "agency": "금융위원회·금융감독원",
      "document": "DSR 규제 + 스트레스 DSR 3단계 (2025.7.1 시행)",
      "year": 2026,
      "laws": [
        "은행업감독규정 §29의2 (DSR)",
        "금융위 가계대출 관리 강화방안 2025.6.27"
      ]
    }
  },
  "constants": {
    "DSR_BANK": 0.4,
    "DSR_NONBANK": 0.5,
    "STRESS_3RD": 0.015,
    "STRESS_2ND_LOCAL": 0.0075
  },
  "formula": [
    {
      "step": 1,
      "name": "적용 금리",
      "expr": "대출이자율 + 스트레스 가산 (3단계 1.5%)"
    },
    {
      "step": 2,
      "name": "월 가용액",
      "expr": "(연소득 × DSR한도)/12 - 기존부채월액"
    },
    {
      "step": 3,
      "name": "최대 대출",
      "expr": "월 가용액 × ((1+월이자율)^회차 − 1) / (월이자율 × (1+월이자율)^회차)"
    }
  ],
  "inputs": [
