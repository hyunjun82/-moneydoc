  "formula": [
    {
      "step": 1,
      "name": "원리금균등 (PMT)",
      "expr": "M = P × r × (1+r)^n / ((1+r)^n - 1)"
    },
    {
      "step": 2,
      "name": "원금균등",
      "expr": "월 원금 = P/n, 월 이자 = 잔액 × r"
    },
    {
      "step": 3,
      "name": "만기일시",
      "expr": "월 이자만 = P × r/12, 만기에 원금 P 일시"
    },
    {
      "step": 4,
      "name": "거치식",
      "expr": "거치기간: 이자만 / 거치 후: 원리금균등 (잔여기간)"
    }
  ],
  "inputs": [
