  "constants": {},
  "formula": [
    {
      "step": 1,
      "name": "적용금리",
      "expr": "대출이자율 + 스트레스 가산"
    },
    {
      "step": 2,
      "name": "월 가용액",
      "expr": "(연소득 × DTI한도)/12 − 기존이자"
    },
    {
      "step": 3,
      "name": "최대 대출",
      "expr": "월가용액 × ((1+월이자율)^회차 − 1) / (월이자율×(1+월이자율)^회차)"
    }
  ],
