  "formula": [
    {
      "step": 1,
      "name": "LTV 비율",
      "expr": "주택수·지역에 따라 lookup"
    },
    {
      "step": 2,
      "name": "1차 한도",
      "expr": "주택가격 × LTV 비율"
    },
    {
      "step": 3,
      "name": "방 공제 (MCI/MCG 미적용 시)",
      "expr": "(방수 - 1) × 지역별 소액보증금"
    },
    {
      "step": 4,
      "name": "임차보증금 차감",
      "expr": "기존 전월세 임차보증금"
    },
    {
      "step": 5,
      "name": "절대 한도",
      "expr": "수도권 규제 6억 (25억 초과 시 8억)"
    },
    {
      "step": 6,
      "name": "최종 한도",
      "expr": "min(1차 한도 - 방공제 - 임차보증금, 절대 한도)"
    }
  ],
