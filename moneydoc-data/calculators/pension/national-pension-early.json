  "formula": [
    {
      "step": 1,
      "name": "조기수령 연수",
      "expr": "정상연령(65) - 시작연령"
    },
    {
      "step": 2,
      "name": "감액률",
      "expr": "조기수령 연수 × 6%"
    },
    {
      "step": 3,
      "name": "감액 후 수령액",
      "expr": "round(정상수령 × (1 - 감액률))"
    }
  ],
