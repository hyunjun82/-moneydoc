      "step": 1,
      "name": "기본 가산 (P)",
      "expr": "가입 240개월 미만: P = 가입월수/240. 240개월 이상: P = 1 + 0.05 × (가입월수-240)/12"
    },
    {
      "step": 2,
      "name": "연금월액",
      "expr": "(비례상수 1.29 × (A + B) × P) / 12"
    },
    {
      "step": 3,
      "name": "연금연액",
      "expr": "월액 × 12"
    }
