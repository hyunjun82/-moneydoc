    {
      "step": 2,
      "name": "연간 연금",
      "expr": "평균소득월액 × 재직년수 × 비례상수 × 12"
    },
    {
      "step": 3,
      "name": "월 연금",
      "expr": "연 / 12"
    }
  ],
