  "title": "퇴직금 계산기",
  "subtitle": "입사일과 퇴사일, 월 기본급으로 법정 퇴직금을 계산해요. 고용노동부 퇴직금 계산기와 같은 방식이에요.",
  "slug": "severance-pay",
  "searchAliases": [
    "퇴직금 계산기",
    "법정 퇴직금 계산기",
    "퇴직금 계산",
    "고용노동부 퇴직금"
  ],
  "year": 2026,
  "lastUpdated": "2026-05-09",
  "lastVerified": "2026-09-02",
  "source": {
    "primary": {
      "agency": "고용노동부",
      "document": "퇴직금 계산기 (고용노동부(moel.go.kr).go.kr/retirementpayCal.do)",
      "year": 2026,
      "laws": [
        "근로자퇴직급여보장법 제8조 (퇴직금제도)",
        "근로기준법 제2조 1항 6호 (평균임금 정의)",
        "근로기준법 시행령 제2조 (평균임금 산정)"
      ]
    }
  },
  "constants": {
    "DAYS_PER_YEAR": 365
  },
  "formula": [
    {
      "step": 1,
      "name": "재직일수",
      "expr": "ceil((퇴사일 - 입사일)/86400000)"
    },
    {
      "step": 2,
      "name": "평균임금 산정 3개월 구간",
      "expr": "퇴사일 직전 3개월 (월별 일수 분리)"
    },
    {
      "step": 3,
      "name": "기간별 기본급 합산",
      "expr": "월급 × 부분월 일수/그달 일수"
    },
    {
      "step": 4,
      "name": "임금총액",
      "expr": "기본급합 + 연간상여×0.25 + 연차수당×0.25"
    },
    {
      "step": 5,
      "name": "1일 평균임금",
      "expr": "ceil2(임금총액 / 3개월 일수)"
    },
    {
      "step": 6,
      "name": "퇴직금",
      "expr": "floor(round(평균임금 × 30 × 재직일수 / 365))"
    }
  ],
  "inputs": [
    {
      "id": "hireDate",
      "label": "입사일",
