        "시행령 제95조"
      ]
    },
    "note": "2026년 개편 — 3단계 구조 + 사후지급 폐지."
  },
  "constants": {
    "PHASE1_RATE": 1.0,
    "PHASE1_UPPER": 2500000,
    "PHASE2_RATE": 1.0,
    "PHASE2_UPPER": 2000000,
    "PHASE3_RATE": 0.8,
    "PHASE3_UPPER": 1600000,
    "MIN_PAY": 700000,
    "PHASE1_MONTHS": 3,
    "PHASE2_MONTHS": 3,
    "UPPER_LIMIT": 1925000
