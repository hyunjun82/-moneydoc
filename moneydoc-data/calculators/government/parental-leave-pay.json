      "laws": [
        "고용보험법 제70조 (육아휴직 급여)",
        "시행령 제95조"
      ]
    },
    "note": "2026년 개편 — 3단계 구조 + 사후지급 폐지."
  },
  "constants": {
    "PHASE1_RATE": 1.0,
    "PHASE1_UPPER": 2500000,
    "PHASE2_RATE": 1.0,
    "PHASE2_UPPER": 2000000,
    "PHASE3_RATE": 0.8,
    "PHASE3_UPPER": 1600000,
    "MIN_PAY": 700000,
    "PHASE1_MONTHS": 3,
    "PHASE2_MONTHS": 3,
    "UPPER_LIMIT": 1925000
  },
  "formula": [
    {
      "step": 1,
      "name": "1~3개월 월액",
      "expr": "max(min(통상임금 × 1.0, 2500000), 700000)"
    },
    {
      "step": 2,
      "name": "4~6개월 월액",
      "expr": "max(min(통상임금 × 1.0, 2000000), 700000)"
    },
    {
      "step": 3,
      "name": "7~12+개월 월액",
      "expr": "max(min(통상임금 × 0.8, 1600000), 700000)"
    },
    {
      "step": 4,
      "name": "총 급여",
      "expr": "min(months,3)×phase1 + max(0,min(months,6)-3)×phase2 + max(0,months-6)×phase3"
    }
  ],
  "inputs": [
    {
      "id": "monthlySalary",
      "label": "통상임금 (월)",
      "type": "currency",
      "min": 700000,
      "default": 3000000
    },
    {
      "id": "leaveMonths",
      "label": "휴직 개월수",
      "type": "number",
      "min": 1,
      "max": 18,
      "default": 12
    }
  ],
