  "formula": [
    {
      "step": 1,
      "name": "1~3개월 월액",
      "expr": "max(min(통상임금 × 1.0, 2500000), 700000)"
    },
    {
      "step": 2,
      "name": "4~6개월 월액",
      "expr": "max(min(통상임금 × 1.0, 2000000), 700000)"
    },
    {
      "step": 3,
      "name": "7~12+개월 월액",
      "expr": "max(min(통상임금 × 0.8, 1600000), 700000)"
    },
    {
      "step": 4,
      "name": "총 급여",
      "expr": "min(months,3)×phase1 + max(0,min(months,6)-3)×phase2 + max(0,months-6)×phase3"
    }
  ],
  "inputs": [
    {
      "id": "monthlySalary",
      "label": "통상임금 (월)",
      "type": "currency",
      "min": 700000,
