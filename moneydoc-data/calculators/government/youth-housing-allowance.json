  "formula": [
    {
      "step": 1,
      "name": "기준 임차료",
      "expr": "가구원수별 (1급지 서울 기준)"
    },
    {
      "step": 2,
      "name": "생계급여 기준",
      "expr": "중위소득 32% 가구원수별"
    },
    {
      "step": 3,
      "name": "자기부담분",
      "expr": "max(0, (소득인정액 - 생계급여기준) × 30%)"
    },
    {
      "step": 4,
      "name": "임차급여",
      "expr": "max(0, 기준임차료 - 자기부담분)"
    },
    {
      "step": 5,
      "name": "자격",
      "expr": "소득인정액 ≤ 중위소득 48% (생계급여기준 × 48/32)"
    }
  ],
  "inputs": [
