    "BENEFIT_RATE": 0.6,
    "DAILY_LOWER_LIMIT": 66048,
    "DAILY_UPPER_LIMIT": 68100,
    "BASE_DAILY_WAGE_CAP": 113500,
    "ELDERLY_DISABLED_BONUS_DAYS": 30
  },
  "tables": {
    "benefitDays": {
      "description": "소정급여일수 (고용보험법 §50). 가입기간 = 피보험단위기간 합산.",
      "rules": [
        {
          "minYears": 0,
          "maxYears": 1,
          "days": 120
        },
        {
          "minYears": 1,
          "maxYears": 3,
          "days": 150
        },
        {
          "minYears": 3,
          "maxYears": 5,
          "days": 180
        },
        {
          "minYears": 5,
          "maxYears": 10,
          "days": 210
        },
        {
          "minYears": 10,
          "maxYears": null,
          "days": 240
        }
      ],
      "bonus": {
        "elderlyOrDisabled": "+30일 (50세 이상 또는 장애인, 단 1년 미만은 가산 없음)"
      }
    }
  },
  "formula": [
    {
      "step": 1,
      "name": "1일 평균임금",
      "expr": "최근 3개월 임금 / 90"
    },
    {
      "step": 2,
      "name": "구직급여 일액 (raw)",
      "expr": "1일 평균임금 × 0.6"
    },
    {
      "step": 3,
      "name": "일액 보정",
      "expr": "max(하한 66,048, min(raw, 상한 68,100))"
    },
    {
      "step": 4,
      "name": "소정급여일수",
      "expr": "가입연수별 lookup, 50세+/장애 +30일 (1년 이상 가산만)"
    },
    {
      "step": 5,
      "name": "총 수령액",
      "expr": "일액 × 일수"
    }
  ],
  "inputs": [
    {
      "id": "monthlySalary",
      "label": "월 평균임금",
      "type": "currency",
      "min": 1000000,
      "max": 50000000,
      "default": 3000000
    },
    {
      "id": "insuredYears",
      "label": "고용보험 가입연수",
      "type": "number",
      "min": 0,
      "max": 40,
      "default": 5
    },
    {
      "id": "isElderlyOrDisabled",
      "label": "50세 이상 또는 장애인",
      "type": "boolean",
      "default": false
    }
  ],
