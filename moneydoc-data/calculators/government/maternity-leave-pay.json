  "formula": [
    {
      "step": 1,
      "name": "총 일수",
      "expr": "단태 90일 / 다태 120일"
    },
    {
      "step": 2,
      "name": "회사 부담",
      "expr": "60일 × 일당 (월 통상임금 / 30)"
    },
    {
      "step": 3,
      "name": "고용보험",
      "expr": "(총일수-60) × min(일당, 상한)"
    },
    {
      "step": 4,
      "name": "총 급여",
      "expr": "회사 + 고용보험"
    }
  ],
