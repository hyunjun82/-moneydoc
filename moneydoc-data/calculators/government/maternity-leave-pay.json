  "formula": [
    {
      "step": 1,
      "name": "총 일수",
      "expr": "단태 90일 / 다태 120일"
    },
    {
      "step": 2,
      "name": "회사 부담",
      "expr": "우선지원 대상기업: max(0, 월 통상임금 − 220만원) × 유급일수(60일, 다태아 75일) ÷ 30. 대규모기업: 월 통상임금 × 유급일수 ÷ 30"
    },
    {
      "step": 3,
      "name": "고용보험",
      "expr": "우선지원 대상기업: min(월 통상임금, 220만원) × 총일수 ÷ 30. 대규모기업: min(월 통상임금, 220만원) × (총일수 − 유급일수) ÷ 30"
    },
    {
      "step": 4,
      "name": "총 급여",
      "expr": "회사 + 고용보험"
    }
  ],
  "inputs": [
