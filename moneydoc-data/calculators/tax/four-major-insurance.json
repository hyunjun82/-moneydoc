      "step": 3,
      "name": "장기요양",
      "expr": "round(건강보험료 × 13.14%)"
    },
    {
      "step": 4,
      "name": "고용보험",
      "expr": "round(보수월액 × 0.9%)"
    },
    {
      "step": 5,
      "name": "총 부담",
      "expr": "합계"
