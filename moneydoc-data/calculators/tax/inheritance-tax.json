  "formula": [
    {
      "step": 1,
      "name": "인적공제 합계",
      "expr": "자녀×5천만 + 미성년자년수×1천만 + 연로자×5천만 + 장애인기대여명×1천만"
    },
    {
      "step": 2,
      "name": "기본공제",
      "expr": "max(일괄 5억, 기초 2억 + 인적공제 합계)"
    },
    {
      "step": 3,
      "name": "배우자공제",
      "expr": "min(30억, max(5억, 상속재산 × 법정상속분))"
    },
    {
      "step": 4,
      "name": "총 공제",
      "expr": "기본공제 + 배우자공제"
    },
    {
      "step": 5,
      "name": "과세표준",
      "expr": "max(0, 상속재산 - 총공제)"
    },
    {
      "step": 6,
      "name": "산출세액",
      "expr": "과세표준 × 세율 - 누진공제"
    }
  ],
  "inputs": [
