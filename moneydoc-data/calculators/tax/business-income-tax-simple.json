  "formula": [
    {
      "step": 1,
      "name": "소득금액",
      "expr": "총수입 × (1 - 경비율)"
    },
    {
      "step": 2,
      "name": "과세표준",
      "expr": "max(0, 소득금액 - 인적공제)"
    },
    {
      "step": 3,
      "name": "산출세액",
      "expr": "종합소득세율 적용"
    },
    {
      "step": 4,
      "name": "지방소득세",
      "expr": "산출세액 × 10%"
    }
  ],
  "inputs": [
