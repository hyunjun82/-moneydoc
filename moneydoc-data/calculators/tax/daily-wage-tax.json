  "formula": [
    {
      "step": 1,
      "name": "과세 일급",
      "expr": "max(0, 일급 - 150,000)"
    },
    {
      "step": 2,
      "name": "산출세액",
      "expr": "과세일급 × 6%"
    },
    {
      "step": 3,
      "name": "근로소득세액공제",
      "expr": "산출세액 × 55%"
    },
    {
      "step": 4,
      "name": "결정세액 (소득세)",
      "expr": "산출세액 × 45% (=과세일급 × 2.7%)"
    },
    {
      "step": 5,
      "name": "소액부징수",
      "expr": "결정세액 < 1,000원이면 0 (국세기본법 §86)"
    },
    {
      "step": 6,
      "name": "지방소득세",
      "expr": "결정세액 × 10%"
    },
    {
      "step": 7,
      "name": "세후 일급",
      "expr": "일급 - 결정세액 - 지방세"
    }
  ],
  "inputs": [
    {
      "id": "dailyWage",
      "label": "일급",
      "type": "currency",
      "min": 100000,
      "default": 200000
    },
    {
      "id": "days",
      "label": "근무 일수",
      "type": "number",
      "min": 1,
      "max": 31,
      "default": 22
    }
  ],
