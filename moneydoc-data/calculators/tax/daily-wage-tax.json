  "formula": [
    {
      "step": 1,
      "name": "과세 일급",
      "expr": "max(0, 일급 - 150,000)"
    },
    {
      "step": 2,
      "name": "일용근로 소득세",
      "expr": "과세일급 × 6% × (1 - 0.55) = 과세일급 × 2.7%"
    },
    {
      "step": 3,
      "name": "지방소득세",
      "expr": "소득세 × 10%"
    },
    {
      "step": 4,
      "name": "세후 일급",
      "expr": "일급 - 소득세 - 지방세"
    }
  ],
