{
  "id": "daily-wage-tax",
  "category": "tax",
  "subCategory": "income",
  "title": "일용직 원천징수 계산기",
  "subtitle": "일급에서 15만원을 공제하고 세율 6%와 세액공제 55%를 적용한 일용직 원천징수액과 실수령액을 계산해요.",
  "slug": "daily-wage-tax",
  "year": 2026,
  "lastUpdated": "2026-05-09",
  "lastVerified": "2026-09-02",
  "source": {
    "primary": {
      "agency": "국세청",
      "document": "소득세법 §134, 시행령 §189",
      "year": 2026
    }
  },
  "constants": {
    "EXEMPT_AMOUNT": 150000,
    "TAX_RATE": 0.06,
    "CREDIT_RATE": 0.45,
    "EFFECTIVE_TAX_RATE": 0.027,
    "LOCAL_TAX_RATE": 0.1
  },
  "formula": [
    {
      "step": 1,
      "name": "과세 일급",
      "expr": "max(0, 일급 - 150,000)"
    },
    {
      "step": 2,
      "name": "산출세액",
      "expr": "과세일급 × 6%"
    },
    {
      "step": 3,
      "name": "근로소득세액공제",
      "expr": "산출세액 × 55%"
    },
    {
      "step": 4,
      "name": "결정세액 (소득세)",
      "expr": "산출세액 × 45% (=과세일급 × 2.7%)"
    },
    {
      "step": 5,
      "name": "소액부징수",
      "expr": "결정세액 < 1,000원이면 0 (국세기본법 §86)"
    },
    {
      "step": 6,
      "name": "지방소득세",
      "expr": "결정세액 × 10%"
    },
    {
      "step": 7,
      "name": "세후 일급",
      "expr": "일급 - 결정세액 - 지방세"
    }
  ],
  "inputs": [
    {
      "id": "dailyWage",
      "label": "일급",
      "type": "currency",
      "min": 100000,
      "default": 200000
    },
    {
      "id": "days",
      "label": "근무 일수",
      "type": "number",
      "min": 1,
      "max": 31,
      "default": 22
    }
  ],
