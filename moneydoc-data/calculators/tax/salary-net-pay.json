    }
  ],
  "formula": [
    {
      "step": 1,
      "id": "monthly",
      "name": "월 세전 급여",
      "expr": "annual / 12"
    },
    {
      "step": 2,
      "id": "npBase",
      "name": "국민연금 보수월액",
      "expr": "min(monthly, NP_CAP_MONTHLY)"
    },
    {
      "step": 3,
      "id": "nationalPension",
      "name": "국민연금",
      "expr": "round(npBase * NP_RATE)"
    },
    {
      "step": 4,
      "id": "healthInsurance",
      "name": "건강보험",
      "expr": "round(monthly * HI_RATE)"
    },
    {
      "step": 5,
      "id": "longTermCare",
      "name": "장기요양보험",
      "expr": "round(healthInsurance * LTC_RATE)"
    },
    {
      "step": 6,
      "id": "employmentInsurance",
      "name": "고용보험",
      "expr": "round(monthly * EI_RATE)"
    },
    {
      "step": 7,
      "id": "totalInsurance",
      "name": "4대보험 합계",
      "expr": "nationalPension + healthInsurance + longTermCare + employmentInsurance"
    },
    {
      "step": 8,
      "id": "earnedIncomeDeduction",
      "name": "근로소득공제 (연간)",
      "expr": "lookup(earnedIncomeDeduction, annual), capped at 20000000"
    },
    {
      "step": 9,
      "id": "personalDeduction",
      "name": "인적공제 (연간)",
      "expr": "dependents * PERSONAL_DEDUCTION"
    },
    {
      "step": 10,
      "id": "taxableIncome",
      "name": "과세표준 (연간)",
      "expr": "max(0, annual - earnedIncomeDeduction - personalDeduction)"
    },
    {
      "step": 11,
      "id": "taxBeforeCredit",
      "name": "산출세액 (연간)",
      "expr": "taxableIncome * 이자율 - progressiveDeduction (lookup incomeTaxBrackets)"
    },
    {
      "step": 12,
      "id": "earnedIncomeCreditRaw",
      "name": "근로소득세액공제 (산출세액 기준)",
      "expr": "computation lookup of taxBeforeCredit"
    },
    {
      "step": 13,
      "id": "earnedIncomeCreditLimit",
      "name": "근로소득세액공제 한도",
      "expr": "limit lookup based on annual (totalSalary)"
    },
    {
      "step": 14,
      "id": "earnedIncomeCredit",
      "name": "적용 근로소득세액공제",
      "expr": "min(earnedIncomeCreditRaw, earnedIncomeCreditLimit)"
    },
    {
      "step": 15,
      "id": "childCredit",
      "name": "자녀세액공제",
      "expr": "lookup(childTaxCredit, kids)"
    },
    {
      "step": 16,
      "id": "annualIncomeTax",
      "name": "결정세액 (연간 소득세)",
      "expr": "max(0, taxBeforeCredit - earnedIncomeCredit - childCredit)"
    },
    {
      "step": 17,
      "id": "monthlyIncomeTax",
      "name": "소득세 (월 환산)",
      "expr": "round(annualIncomeTax / 12)"
    },
    {
      "step": 18,
      "id": "monthlyLocalTax",
      "name": "지방소득세 (월)",
      "expr": "round(monthlyIncomeTax * LOCAL_TAX_RATE)"
    },
    {
      "step": 19,
      "id": "totalDeduction",
      "name": "총 공제액 (월)",
      "expr": "totalInsurance + monthlyIncomeTax + monthlyLocalTax"
    },
    {
      "step": 20,
      "id": "netMonthly",
      "name": "월 실수령액",
      "expr": "monthly - totalDeduction"
    }
  ],
  "verification": {
    "verified": true,
    "verifiedAt": "2026-09-01",
    "method": "4대보험 요율 2026년 9월 기준 (국민연금 본인 4.75%·기준소득월액 상한 6,590,000·하한 410,000 [2026.7~2027.6], 건강보험 본인 3.595%, 장기요양 건강보험료의 13.14%, 고용보험 본인 0.9%). 외부 교차검증: 연봉탐색기(job.cosmosfarm.com) 2026 실수령액표와 4대보험 4개 항목 전부 일치(±30원, 간이세액표 구간 중앙값 차이). 소득세는 간이세액표 약식산식이라 연봉 5천만 이상에서 월 1.4~1.6만원 차이가 있음(연말정산에서 정산).",
