  "inputs": [
    {
      "id": "annual",
      "label": "연봉",
      "type": "currency",
      "min": 12000000,
      "max": 1000000000,
      "step": 100000,
      "default": 50000000,
      "hint": "세전 기준 (식대·차량유지비 등 비과세 제외)"
    },
    {
