    },
    {
      "id": "nontaxable",
      "label": "비과세액 (월)",
      "type": "currency",
      "min": 0,
      "max": 1000000,
      "step": 10000,
      "default": 0,
      "hint": "식대·차량유지비 등 (월 한도 합계)"
    }
  ],
  "formula": [
    {
      "step": 1,
      "id": "monthly",
      "name": "월급여 (비과세 제외)",
      "expr": "floor(annual / 12 − nontaxable)"
    },
    {
      "step": 2,
      "id": "npBase",
      "name": "국민연금 보수월액",
      "expr": "min(monthly, NP_CAP_MONTHLY)"
    },
    {
      "step": 3,
      "id": "nationalPension",
      "name": "국민연금",
      "expr": "round(npBase * NP_RATE)"
    },
    {
      "step": 4,
      "id": "healthInsurance",
      "name": "건강보험",
      "expr": "round(monthly * HI_RATE)"
    },
    {
      "step": 5,
      "id": "longTermCare",
      "name": "장기요양보험",
      "expr": "round(healthInsurance * LTC_RATE)"
    },
    {
      "step": 6,
      "id": "employmentInsurance",
      "name": "고용보험",
      "expr": "round(monthly * EI_RATE)"
    },
    {
      "step": 7,
      "id": "totalInsurance",
      "name": "4대보험 합계",
      "expr": "nationalPension + healthInsurance + longTermCare + employmentInsurance"
    },
    {
      "step": 8,
      "id": "incomeTax100",
      "name": "소득세 (간이세액표 100%)",
      "expr": "lookup(simplifiedTax, monthly, dependents) − childAdjust(kids)"
    },
    {
      "step": 9,
      "id": "monthlyIncomeTax",
      "name": "소득세 (선택 비율 적용)",
      "expr": "cutOff10(incomeTax100 × taxRatePct / 100)"
    },
    {
      "step": 10,
      "id": "monthlyLocalTax",
      "name": "지방소득세",
      "expr": "cutOff10(monthlyIncomeTax × LOCAL_TAX_RATE)"
    },
    {
      "step": 11,
      "id": "totalDeduction",
      "name": "공제 합계",
      "expr": "cutOff10(totalInsurance + monthlyIncomeTax + monthlyLocalTax)"
    },
    {
      "step": 12,
      "id": "netMonthly",
      "name": "월 실수령액",
      "expr": "cutOff10(monthly + nontaxable − totalDeduction)"
    }
  ],
  "verification": {
