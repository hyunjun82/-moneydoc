  "formula": [
    {
      "step": 1,
      "name": "과세표준",
      "expr": "max(0, 소득 - dependents * PERSONAL_DEDUCTION - extraDeduction)"
    },
    {
      "step": 2,
      "name": "산출세액",
      "expr": "taxable * 이자율 - progressiveDeduction (lookup)"
    },
    {
      "step": 3,
      "name": "자녀세액공제",
      "expr": "lookup(childTaxCredit, kids)"
    },
    {
      "step": 4,
      "name": "결정세액",
      "expr": "max(0, taxBeforeCredit - childCredit - extraTaxCredit)"
    },
    {
      "step": 5,
      "name": "지방소득세",
      "expr": "round(decisionTax * 0.10)"
    },
    {
      "step": 6,
      "name": "총 세금",
      "expr": "decisionTax + localTax"
    }
  ],
