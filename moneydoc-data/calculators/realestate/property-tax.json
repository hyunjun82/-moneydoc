  "formula": [
    {
      "step": 1,
      "name": "공정시장가액비율",
      "expr": "1세대1주택 ? (3억 이하 43% / 6억 이하 44% / 6억 초과 45%) : 60%"
    },
    {
      "step": 2,
      "name": "과세표준",
      "expr": "round(공시가 × 비율)"
    },
    {
      "step": 3,
      "name": "재산세",
      "expr": "lookup (1세대1주택이고 공시 9억 이하 → 특례세율, 그 외 → 표준세율)"
    },
    {
      "step": 4,
      "name": "지방교육세",
      "expr": "재산세 × 20%"
    },
    {
      "step": 5,
      "name": "총 납부",
      "expr": "재산세 + 지방교육세"
    }
  ],
