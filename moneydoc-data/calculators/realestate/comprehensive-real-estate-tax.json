  "formula": [
    {
      "step": 1,
      "id": "totalValue",
      "name": "공시가격 합계",
      "expr": "value1 + value2 + value3"
    },
    {
      "step": 2,
      "id": "taxableBase",
      "name": "과세표준",
      "expr": "floor((합계 − 공제) × 60%), 공제 = 1세대1주택 12억 / 그 외 9억"
    },
    {
      "step": 3,
      "id": "taxBeforePropertyCredit",
      "name": "재산세공제 전 종부세",
      "expr": "누진세율 (3주택 이상 & 과표 12억 초과면 중과세율)"
    },
    {
      "step": 4,
      "id": "propertyTaxCredit",
      "name": "공제할 재산세액",
      "expr": "재산세 합계 × trunc8((과표 × 재산세 공정시장가액비율 × 0.4%) / 합산공시가 기준 재산세)"
    },
    {
      "step": 5,
      "id": "creditTotal",
      "name": "1주택 세액공제",
      "expr": "min(고령자 + 장기보유, 산출세액 × 80%)"
    },
    {
      "step": 6,
      "id": "payableTax",
      "name": "납부세액",
      "expr": "종부세액 + 농어촌특별세(20%)"
    }
  ],
