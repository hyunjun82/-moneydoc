      "description": "일반 장기보유특별공제 (다주택자, 1세대1주택 거주 미달자)",
      "formula": "보유 3년 미만 0%, 3년 6%, 매년 +2%, 15년 이상 30% 한도"
    },
    "ltbc1Home": {
      "description": "1세대1주택 장특공제 (보유 2년+ 거주 2년+, 시행령 §159의3)",
      "formula": "보유연수 × 4% (한도 40%) + 거주연수 × 4% (한도 40%) = 합계 한도 80%"
    }
  },
  "inputs": [
    { "id": "salePrice", "label": "양도가액", "type": "currency", "min": 0, "default": 1500000000 },
    { "id": "acquisitionPrice", "label": "취득가액", "type": "currency", "min": 0, "default": 800000000 },
    { "id": "expense", "label": "필요경비", "type": "currency", "min": 0, "default": 0, "hint": "취득세, 중개수수료, 양도시 비용 등" },
    { "id": "holdingYears", "label": "보유연수", "type": "number", "min": 0, "max": 50, "default": 10 },
    { "id": "livedYears", "label": "거주연수", "type": "number", "min": 0, "max": 50, "default": 10 },
    { "id": "isOneHome", "label": "1세대 1주택 여부", "type": "boolean", "default": true }
  ],
  "formula": [
    { "step": 1, "name": "양도차익", "expr": "salePrice - acquisitionPrice - expense" },
    { "step": 2, "name": "1세대1주택 비과세 판정", "expr": "isOneHome && holdingYears >= 2 && livedYears >= 2" },
    { "step": 3, "name": "비과세 처리", "expr": "비과세 + salePrice <= 12억: 양도세 0. 비과세 + salePrice > 12억: 과세분 = 차익 × (salePrice-12억)/salePrice" },
    { "step": 4, "name": "LBC 1세대1주택", "expr": "보유연수 × 4% (max 40%) + 거주연수 × 4% (max 40%), 합계 max 80%" },
    { "step": 5, "name": "LBC 일반", "expr": "보유 3년 미만 0%, 3년부터 6%, 매년 +2%, 15년+ 30% 한도" },
    { "step": 6, "name": "양도소득금액", "expr": "과세차익 × (1 - LBC율)" },
    { "step": 7, "name": "과세표준", "expr": "max(0, 양도소득금액 - 250만)" },
    { "step": 8, "name": "산출세액", "expr": "lookup(brackets, taxable)" },
    { "step": 9, "name": "지방소득세", "expr": "산출세액 × 10%" },
    { "step": 10, "name": "총 세금", "expr": "산출세액 + 지방소득세" }
  ],
