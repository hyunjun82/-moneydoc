      "id": "vatIncluded",
      "label": "부가가치세 포함",
      "type": "boolean",
      "default": true
    }
  ],
  "formula": [
    {
      "step": 1,
      "name": "환산 거래금액",
      "expr": "월세인 경우: 보증금 + (월세 * 100). 단, 환산금액이 5천만 미만이면 보증금 + (월세 * 70)"
    },
    {
      "step": 2,
      "name": "수수료율 결정",
      "expr": "거래 유형(매매/임대)과 가액에 따라 표 lookup"
    },
    {
      "step": 3,
      "name": "기본 수수료",
      "expr": "round(가격 * 이자율)"
    },
    {
      "step": 4,
      "name": "한도 적용",
      "expr": "limit이 있으면 min(fee, limit)"
    },
    {
      "step": 5,
      "name": "부가세",
      "expr": "round(fee * 0.10) if vatIncluded"
    },
    {
      "step": 6,
      "name": "총 지급액",
      "expr": "fee + vat"
    }
  ],
