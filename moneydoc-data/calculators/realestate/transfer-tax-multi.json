  "formula": [
    { "step": 1, "name": "양도차익", "expr": "salePrice - acquisitionPrice - expense" },
    { "step": 2, "name": "단기 판정", "expr": "보유 1년 미만: 70%, 1년 ~ 2년 미만: 60%, 2년 이상: 일반 누진" },
    { "step": 3, "name": "LBC", "expr": "보유 3년 이상부터 6%, 매년 +2%, 15년 이상 30% 한도. 2년 미만: 0% (단기는 LBC 미적용)" },
    { "step": 4, "name": "양도소득금액", "expr": "차익 × (1 - LBC율)" },
    { "step": 5, "name": "과세표준", "expr": "양도소득금액 - 250만" },
    { "step": 6, "name": "산출세액", "expr": "단기: 과표 × 단기세율, 일반: lookup 누진세율" },
    { "step": 7, "name": "지방세 + 총", "expr": "산출세액 + (산출세액 × 10%)" }
  ],
  "inputs": [
    { "id": "salePrice", "label": "양도가액", "type": "currency", "min": 0, "default": 800000000 },
    { "id": "acquisitionPrice", "label": "취득가액", "type": "currency", "min": 0, "default": 500000000 },
    { "id": "expense", "label": "필요경비", "type": "currency", "min": 0, "default": 0 },
    { "id": "holdingYears", "label": "보유연수", "type": "number", "min": 0, "max": 50, "default": 5 }
