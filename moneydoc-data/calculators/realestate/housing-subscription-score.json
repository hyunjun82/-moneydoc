{
  "id": "housing-subscription-score",
  "category": "realestate",
  "subCategory": "subscription",
  "title": "청약 가점 계산기",
  "subtitle": "무주택기간, 부양가족 수, 청약통장 가입기간 점수를 더해 청약 가점을 계산해요. 84점이 만점이에요.",
  "slug": "housing-subscription-score",
  "year": 2026,
  "lastUpdated": "2026-05-09",
  "lastVerified": "2026-09-02",
  "source": {
    "primary": {
      "agency": "국토교통부",
      "document": "주택공급규칙 §28",
      "year": 2026
    }
  },
  "constants": {
    "MAX_NO_HOME": 32,
    "MAX_FAMILY": 35,
    "MAX_ACCOUNT": 17
  },
  "formula": [
    {
      "step": 1,
      "name": "무주택 점수",
      "expr": "1년 미만 2점, 그 뒤 min(32, (floor(무주택연수) + 1) × 2)"
    },
    {
      "step": 2,
      "name": "부양가족 점수",
      "expr": "min(35, 5 + 부양가족 × 5)"
    },
    {
      "step": 3,
      "name": "청약통장 점수",
      "expr": "6개월 미만 1점 / 1년 미만 2점 / 1년+ 매년 +1점 (15년+ 17점). 산식: accountYears < 0.5 ? 1 : accountYears < 1 ? 2 : min(17, floor(accountYears) + 2)"
    }
  ],
  "inputs": [
    {
      "id": "noHomeYears",
      "label": "무주택 기간 (년)",
      "type": "number",
      "min": 0,
      "max": 20,
      "default": 5,
      "hint": "무주택자 기준 (1년 미만 2점, 15년 이상 32점). 유주택자·만 30세 미만 미혼은 0점"
    },
    {
      "id": "dependents",
      "label": "부양가족 수",
      "type": "stepper",
      "min": 0,
      "max": 6,
      "default": 2
    },
    {
      "id": "accountYears",
      "label": "청약통장 가입기간 (년)",
      "type": "number",
      "min": 0,
      "max": 20,
      "default": 5
    }
  ],
  "outputLabels": {
    "total": "총 가점"
  },
  "outputUnits": {
    "total": "점",
    "noHomeScore": "점",
    "familyScore": "점",
    "accountScore": "점"
  },
