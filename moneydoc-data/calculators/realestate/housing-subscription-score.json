  "formula": [
    {
      "step": 1,
      "name": "무주택 점수",
      "expr": "min(32, 무주택연수 × 2)"
    },
    {
      "step": 2,
      "name": "부양가족 점수",
      "expr": "min(35, 5 + 부양가족 × 5)"
    },
    {
      "step": 3,
      "name": "청약통장 점수",
      "expr": "6개월 미만 1점 / 1년 미만 2점 / 1년+ 매년 +1점 (15년+ 17점). 산식: accountYears < 0.5 ? 1 : accountYears < 1 ? 2 : min(17, accountYears + 1)"
    }
  ],
  "inputs": [
    {
      "id": "noHomeYears",
      "label": "무주택 기간 (년)",
      "type": "number",
      "min": 0,
      "max": 20,
      "default": 5
    },
    {
      "id": "dependents",
      "label": "부양가족 수",
      "type": "stepper",
      "min": 0,
      "max": 6,
      "default": 2
    },
    {
      "id": "accountYears",
      "label": "청약통장 가입기간 (년)",
      "type": "number",
      "min": 0,
      "max": 20,
      "default": 5
    }
  ],
