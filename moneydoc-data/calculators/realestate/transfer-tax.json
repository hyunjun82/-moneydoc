    "ltbcGeneral": {
      "description": "일반 장기보유특별공제 (다주택자, 1세대1주택 거주 미달자)",
      "formula": "보유 3년 미만 0%, 3년 6%, 매년 +2%, 15년 이상 30% 한도"
    },
    "ltbc1Home": {
      "description": "1세대1주택 장특공제 (보유 3년+ AND 거주 2년+, 시행령 §159의3)",
      "formula": "보유연수 × 4% (한도 40%) + 거주연수 × 4% (한도 40%) = 합계 한도 80%. 적용 요건: 보유 3년 이상 + 거주 2년 이상 모두 충족."
    }
  },
  "inputs": [
    {
      "id": "taxMode",
      "label": "양도 상황",
      "type": "select",
      "default": "1home",
      "options": [
        {
          "value": "1home",
          "label": "1세대 1주택 (12억 비과세 + LBC 우대)"
        },
        {
          "value": "multi",
          "label": "다주택자 (일반 누진세 + LBC 일반)"
        },
        {
          "value": "adjusted",
          "label": "조정대상지역 다주택 (가산세율 +20~30%p)"
        }
      ]
    },
    {
      "id": "salePrice",
      "label": "양도가액",
      "type": "currency",
      "min": 0,
      "default": 1500000000
    },
    {
      "id": "acquisitionPrice",
      "label": "취득가액",
      "type": "currency",
      "min": 0,
      "default": 800000000
    },
    {
      "id": "expense",
      "label": "필요경비",
      "type": "currency",
      "min": 0,
      "default": 0,
      "hint": "취득세, 중개수수료 등"
    },
    {
      "id": "holdingYears",
      "label": "보유연수",
      "type": "number",
      "min": 0,
      "max": 50,
      "default": 10
    },
    {
      "id": "livedYears",
      "label": "거주연수 (1주택만 적용)",
      "type": "number",
      "min": 0,
      "max": 50,
      "default": 10
    },
    {
      "id": "adjustedArea",
      "label": "취득 당시 조정대상지역",
      "type": "select",
      "default": "no",
      "options": [
        {
          "value": "no",
          "label": "아니오 (보유 2년만 충족하면 비과세)"
        },
        {
          "value": "yes",
          "label": "예 (보유 2년 + 거주 2년 필요)"
        }
      ],
      "hint": "조정대상지역 주택만 거주 2년 요건이 추가됩니다 (소득세법 시행령 §154①)"
    },
    {
      "id": "homeCount",
      "label": "주택수 (다주택만)",
      "type": "number",
      "min": 1,
      "max": 10,
      "default": 2
    }
  ],
  "formula": [
    {
      "step": 1,
      "name": "양도차익",
      "expr": "salePrice - acquisitionPrice - expense"
    },
    {
      "step": 2,
      "name": "1세대1주택",
      "expr": "12억 비과세 (보유 2년+ 거주 2년+) + LBC 보유×4% + 거주×4% (max 80%)"
    },
    {
      "step": 3,
      "name": "다주택자",
      "expr": "일반 누진세 + LBC 일반 (보유×2%, max 30%)"
    },
    {
      "step": 4,
      "name": "조정대상지역",
      "expr": "다주택 + 가산세율 +20~30%p (2주택 +20, 3주택+ +30)"
    },
    {
      "step": 5,
      "name": "지방소득세",
      "expr": "산출세액 × 10%"
    }
  ],
