  "formula": [
    {
      "step": 1,
      "id": "propertyTax",
      "name": "재산세 합계",
      "expr": "주택별 floor(공시가 × 공정시장가액비율) 에 표준세율"
    },
    {
      "step": 2,
      "id": "propertyEduTax",
      "name": "지방교육세",
      "expr": "재산세 × 20%"
    },
    {
      "step": 3,
      "id": "compPayable",
      "name": "종부세 납부액",
      "expr": "종부세 계산기와 동일 (재산세공제·세액공제·농특세 반영)"
    },
    {
      "step": 4,
      "id": "totalTax",
      "name": "보유세 합계",
      "expr": "재산세 + 지방교육세 + 종부세 납부액"
    }
  ],
