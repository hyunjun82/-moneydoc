  "formula": [
    {
      "step": 1,
      "name": "재산세",
      "expr": "공시가 × 60% × 재산세 누진 (0.1~0.4%)"
    },
    {
      "step": 2,
      "name": "재산세 지방교육세",
      "expr": "재산세 × 20%"
    },
    {
      "step": 3,
      "name": "종합부동산세",
      "expr": "(공시가 - 공제) × 60% × 종부세 누진 (1주택 0.5~2.7% / 일반 0.5~5.0%)"
    },
    {
      "step": 4,
      "name": "총 보유세",
      "expr": "재산세 + 교육세 + 종부세"
    }
  ],
