  "inputs": [
    {
      "id": "price",
      "label": "매매가액",
      "type": "currency",
      "min": 10000000,
      "max": 100000000000,
      "default": 500000000
    },
    {
      "id": "houseCountAfter",
      "label": "취득 후 보유 주택 수",
      "type": "stepper",
      "min": 1,
      "max": 5,
      "default": 1
    },
    {
      "id": "adjustedArea",
      "label": "조정대상지역 여부",
      "type": "boolean",
      "default": false
    },
    {
      "id": "areaSize",
      "label": "전용면적 (㎡)",
      "type": "number",
      "min": 1,
      "max": 500,
      "default": 84,
      "hint": "85㎡ 초과 시 농특세 0.2% 추가"
    }
  ],
  "formula": [
    {
      "step": 1,
      "name": "취득세율 결정",
      "expr": "1주택은 가액별 표준세율, 다주택은 조정대상지역 여부에 따라 8% 또는 12%"
    },
    {
      "step": 2,
      "name": "취득세",
      "expr": "round(가격 * acquisitionRate)"
    },
    {
      "step": 3,
      "name": "농어촌특별세",
      "expr": "전용면적 > 85㎡ 또는 다주택중과 시 적용 (단순화: 전용 85㎡ 초과 시 0.2%)"
    },
    {
      "step": 4,
      "name": "지방교육세",
      "expr": "round(acquisitionTax * 0.10)"
    },
    {
      "step": 5,
      "name": "총 납부액",
      "expr": "acquisitionTax + ruralTax + educationTax"
    }
  ],
  "verification": {
    "verified": true,
    "verifiedAt": "2026-05-01",
    "method": "부동산계산기.com (한국 권위 사이트) 1주택 케이스 1:1 일치 확인. 다주택 중과세 (Case 4, 5)는 지방세법 §13의2 옛 산식 유지 (8%/12%. 부동산계산기.com이 일부 폐지 반영했지만 법정 미개정 상태).",
