{
  "id": "acquisition-tax",
  "category": "realestate",
  "subCategory": "tax",
  "title": "취득세 계산기",
  "subtitle": "주택을 살 때 내는 취득세와 농어촌특별세, 지방교육세를 한 번에 계산해요.",
  "slug": "acquisition-tax",
  "searchAliases": [
    "취득세 계산기",
    "주택 취득세 계산기",
    "부동산 취득세 계산기"
  ],
  "year": 2026,
  "lastUpdated": "2026-05-09",
  "lastVerified": "2026-05-09",
  "source": {
    "primary": {
      "agency": "행정안전부",
      "document": "지방세법",
      "year": 2026,
      "laws": [
        "지방세법 제11조 제1항 제8호 (주택 유상거래 표준세율 1~3%)",
        "지방세법 제13조의2 제1항 (법인·다주택 중과: 2호 조정2주택·비조정3주택 8% / 3호 조정3주택↑·비조정4주택↑ 12%)",
        "지방세법 제6조 제19호 (중과기준세율 1천분의 20)",
        "지방세법 제151조 제1항 제1호 (지방교육세 — 일반은 취득세액의 10%, 제13조의2 중과는 과세표준의 0.4%)",
        "농어촌특별세법 제5조 제1항 제6호 (표준세율 2%로 산출한 취득세액의 10% = 과세표준의 0.2%)"
      ]
    }
  },
  "constants": {
    "EDUCATION_TAX_RATE": 0.1,
    "RURAL_TAX_RATE": 0.002,
    "RURAL_AREA_THRESHOLD": 85
  },
  "tables": {
    "standardRates": {
      "description": "1주택자 (또는 무주택자→1주택) 표준세율 (지방세법 §11)",
      "brackets": [
        {
          "upperBound": 600000000,
          "rate": 0.01,
          "type": "fixed"
        },
        {
          "upperBound": 900000000,
          "type": "linear",
          "formula": "((price/1억) × 2/3 - 3) / 100"
        },
        {
          "upperBound": null,
          "rate": 0.03,
          "type": "fixed"
        }
      ]
    },
    "multiHouseRates": {
      "description": "다주택자 중과세율 (지방세법 §13의2)",
      "rules": [
        {
          "currentHouses": 1,
          "adjusted": false,
          "rate": "표준세율"
        },
        {
          "currentHouses": 1,
          "adjusted": true,
          "rate": "표준세율"
        },
        {
          "currentHouses": 2,
          "adjusted": false,
          "rate": "표준세율"
        },
        {
          "currentHouses": 2,
          "adjusted": true,
          "rate": 0.08
        },
        {
          "currentHouses": 3,
          "adjusted": false,
          "rate": 0.08
        },
        {
          "currentHouses": 3,
          "adjusted": true,
          "rate": 0.12
        },
        {
          "currentHouses": 4,
          "adjusted": false,
          "rate": 0.12
        },
        {
          "currentHouses": 4,
          "adjusted": true,
          "rate": 0.12
        }
      ],
      "note": "currentHouses는 취득 후 보유 주택 수. 4주택+ 모두 12%."
    }
  },
  "inputs": [
    {
      "id": "price",
      "label": "매매가액",
      "type": "currency",
      "min": 10000000,
      "max": 100000000000,
      "default": 500000000
    },
    {
      "id": "houseCountAfter",
      "label": "취득 후 보유 주택 수",
      "type": "stepper",
      "min": 1,
      "max": 5,
      "default": 1
    },
    {
      "id": "adjustedArea",
      "label": "조정대상지역 여부",
      "type": "boolean",
      "default": false
    },
    {
      "id": "areaSize",
      "label": "전용면적 (㎡)",
      "type": "number",
      "min": 1,
      "max": 500,
      "default": 84,
      "hint": "85㎡ 초과 시 농특세 0.2% 추가"
    }
  ],
  "formula": [
    {
      "step": 1,
      "name": "취득세율 결정",
      "expr": "1주택은 가액별 표준세율, 다주택은 조정대상지역 여부에 따라 8% 또는 12%"
    },
    {
      "step": 2,
      "name": "취득세",
      "expr": "round(가격 * acquisitionRate)"
    },
    {
      "step": 3,
      "name": "농어촌특별세",
      "expr": "전용면적 > 85㎡ 또는 다주택중과 시 적용 (단순화: 전용 85㎡ 초과 시 0.2%)"
    },
    {
      "step": 4,
      "name": "지방교육세",
      "expr": "round(acquisitionTax * 0.10)"
    },
    {
      "step": 5,
      "name": "총 납부액",
      "expr": "acquisitionTax + ruralTax + educationTax"
    }
  ],
