      ]
    },
    "multiHouseRates": {
      "description": "다주택자 중과세율 (지방세법 §13의2)",
      "rules": [
        { "currentHouses": 1, "adjusted": false, "rate": "표준세율" },
        { "currentHouses": 1, "adjusted": true, "rate": "표준세율" },
        { "currentHouses": 2, "adjusted": false, "rate": "표준세율" },
        { "currentHouses": 2, "adjusted": true, "rate": 0.08 },
        { "currentHouses": 3, "adjusted": false, "rate": 0.08 },
        { "currentHouses": 3, "adjusted": true, "rate": 0.12 },
        { "currentHouses": 4, "adjusted": false, "rate": 0.12 },
        { "currentHouses": 4, "adjusted": true, "rate": 0.12 }
      ],
      "note": "currentHouses는 취득 후 보유 주택 수. 4주택+ 모두 12%."
