  "tables": {
    "standardRates": {
      "description": "1주택자 (또는 무주택자→1주택) 표준세율 (지방세법 §11)",
      "brackets": [
        { "upperBound": 600000000, "rate": 0.01, "type": "fixed" },
        { "upperBound": 900000000, "type": "linear", "formula": "((price/1억) × 2/3 - 3) / 100" },
