    {
      "step": 1,
      "name": "투자금",
      "expr": "매매가 - 보증금"
    },
    {
      "step": 2,
      "name": "연간 임대수입",
      "expr": "월세 × 12"
    },
    {
      "step": 3,
      "name": "순임대수입",
      "expr": "연 임대수입 - 연간 비용 (관리비·세금·유지보수)"
    },
    {
      "step": 4,
      "name": "총수익률 (Gross)",
      "expr": "연 임대수입 / 투자금 × 100"
    },
    {
      "step": 5,
      "name": "순수익률 (Net)",
      "expr": "순임대수입 / 투자금 × 100"
    }
  ],
