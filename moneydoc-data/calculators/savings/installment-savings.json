  "constants": {
    "INTEREST_TAX_RATE": 0.154,
    "INTEREST_TAX_NOTE": "이자소득세 14% + 지방소득세 1.4% (소득세법 §129)"
  },
  "formula": [
    {
      "step": 1,
      "name": "원금",
      "expr": "monthlyDeposit × months"
    },
    {
      "step": 2,
      "name": "이자 (단리)",
      "expr": "monthly × (rate/12) × months × (months+1) / 2"
    },
    {
      "step": 3,
      "name": "이자 (복리, annuity-due)",
      "expr": "monthly × ((1+r/12)^n − 1) / (r/12) × (1+r/12) − principal"
    },
    {
      "step": 4,
      "name": "이자소득세",
      "expr": "interest × 0.154 (비과세 시 0)"
    },
    {
      "step": 5,
      "name": "만기 세후 수령액",
      "expr": "원금 + 이자 − 이자소득세"
    }
  ],
  "inputs": [
    {
      "id": "monthlyDeposit",
      "label": "월 납입금",
      "type": "currency",
      "min": 10000,
      "max": 30000000,
      "step": 10000,
      "default": 500000,
      "hint": "매월 자동이체할 금액"
    },
    {
      "id": "months",
      "label": "납입월수",
      "type": "number",
      "min": 1,
      "max": 600,
      "default": 24,
      "hint": "보통 6/12/24/36/60개월"
    },
    {
      "id": "rate",
      "label": "연이율",
      "type": "number",
      "min": 0.001,
      "max": 0.2,
      "step": 0.001,
      "default": 0.04,
      "hint": "약정금리 + 우대금리 합계"
    },
    {
      "id": "mode",
      "label": "이자 계산 방식",
      "type": "select",
      "default": "compound",
      "options": [
        {
          "value": "simple",
          "label": "단리"
        },
        {
          "value": "compound",
          "label": "복리 (월복리, annuity-due)"
        }
      ],
      "hint": "복리는 한국 표준 월복리 (월초 납입)"
    },
    {
      "id": "taxFree",
      "label": "비과세 적용",
      "type": "select",
      "default": "no",
      "options": [
        {
          "value": "no",
          "label": "일반 과세 (이자세 15.4%)"
        },
        {
          "value": "yes",
          "label": "비과세종합저축 (0%)"
        }
      ],
      "hint": "비과세 자격: 만 65세↑ / 장애인 / 독립유공자 등"
    }
  ],
