  "constants": {
    "INTEREST_TAX_RATE": 0.154,
    "INTEREST_TAX_NOTE": "이자소득세 14% + 지방소득세 1.4% (소득세법 §129)"
  },
  "formula": [
    {
      "step": 1,
      "name": "원금 합계",
      "expr": "월 납입금 × 납입 개월수"
    },
    {
      "step": 2,
      "name": "이자 (단리)",
      "expr": "월납입 × (연이율/12) × 개월수 × (개월수 + 1) / 2"
    },
    {
      "step": 3,
      "name": "이자 (복리, 월초 납입)",
      "expr": "월납입 × ((1 + 연이율/12)^개월수 − 1) / (연이율/12) × (1 + 연이율/12) − 원금"
    },
    {
      "step": 4,
      "name": "세후 만기 수령액",
      "expr": "원금 + 이자 − (이자 × 15.4%)  // 비과세 자격자는 세금 0%"
    }
  ],
  "inputs": [
