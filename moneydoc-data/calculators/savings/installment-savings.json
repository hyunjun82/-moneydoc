    "primary": {
      "agency": "한국은행 / 금융감독원",
      "document": "월적립식 단리·복리 표준 산식 (annuity-due)",
      "year": 2026,
      "laws": [
        "소득세법 §16 (이자소득)",
        "소득세법 §129 (원천징수세율 14% + 지방세 1.4%)",
        "조세특례제한법 §88의2 (비과세종합저축)"
      ]
    },
    "secondary": [
      {
        "agency": "금융감독원",
        "name": "금융상품통합비교공시 finlife.fss.or.kr"
