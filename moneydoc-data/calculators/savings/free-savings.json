  "formula": [
    {
      "step": 1,
      "name": "원금",
      "expr": "월 평균 납입 × 월수"
    },
    {
      "step": 2,
      "name": "이자 (단리)",
      "expr": "월 평균 × (이자율/12) × 개월수(개월수+1)/2"
    },
    {
      "step": 3,
      "name": "이자소득세",
      "expr": "이자 × 15.4% (비과세 시 0)"
    },
    {
      "step": 4,
      "name": "세후 만기",
      "expr": "원금 + 이자 - 세금"
    }
  ],
