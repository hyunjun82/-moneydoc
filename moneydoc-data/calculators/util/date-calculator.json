  "formula": [
    {
      "step": 1,
      "name": "총 일수",
      "expr": "Math.ceil((endDate - startDate) / 1일)"
    },
    {
      "step": 2,
      "name": "년/월/일",
      "expr": "년 = floor(일수/365), 월 = floor((일수%365)/30), 일 = 나머지"
    }
  ],
