  "formula": [
    {
      "step": 1,
      "name": "만 나이",
      "expr": "오늘 연도 - 출생연도, 생일 안 지났으면 -1"
    },
    {
      "step": 2,
      "name": "한국 나이",
      "expr": "오늘 연도 - 출생연도 + 1 (제도 폐지, 일부 사용)"
    },
    {
      "step": 3,
      "name": "띠",
      "expr": "출생연도 % 12 → 12지지 lookup"
    }
  ],
