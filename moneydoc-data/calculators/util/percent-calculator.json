  "formula": [
    {
      "step": 1,
      "name": "percentOf",
      "expr": "A의 B% = A × B / 100"
    },
    {
      "step": 2,
      "name": "ratio",
      "expr": "A는 B의 몇 % = A / B × 100"
    },
    {
      "step": 3,
      "name": "increase",
      "expr": "A→B 증감률 = (B-A) / A × 100"
    },
    {
      "step": 4,
      "name": "afterIncrease",
      "expr": "A에서 B% 증가 = A × (1 + B/100)"
    }
