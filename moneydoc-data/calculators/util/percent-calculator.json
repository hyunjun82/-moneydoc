    "faq": [
      {
        "q": "5만의 15%는?",
        "a": "5만 × 0.15 = 7,500. 일반 팁·세금 계산에 자주 쓰는 패턴."
      },
      {
        "q": "100만 → 130만 증감률?",
        "a": "(130-100) ÷ 100 × 100 = 30% 증가. 음수면 감소."
